{
  "name": "pocketdeck",
  "productName": "PocketDeck",
  "version": "1.0.0",
  "description": "PocketDeck by Ganesh Acharya: turn any Android phone or tablet into a control deck for your Windows PC. Design the deck on your PC in a preview that takes the size and shape of your device.",
  "main": "main.js",
  "author": "Ganesh Acharya",
  "contributors": [
    "Claude (AI assistant by Anthropic)"
  ],
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node src/standalone.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-static": "^0.460.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pocketdeck.desktop",
    "productName": "PocketDeck",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "editor/**",
      "companion/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "PocketDeck"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PocketDeck",
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "selectPerMachineByDefault": false,
      "include": "build/installer.nsh"
    },
    "copyright": "Copyright © 2026 Ganesh Acharya",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "appx": {
      "identityName": "PocketDeck.Test",
      "publisher": "CN=PocketDeck Test",
      "publisherDisplayName": "Ganesh Acharya",
      "applicationId": "PocketDeck",
      "displayName": "PocketDeck",
      "backgroundColor": "transparent",
      "languages": [
        "en-AU",
        "en-US"
      ],
      "customManifestPath": "appxmanifest.xml",
      "artifactName": "PocketDeck-Store.${ext}",
      "addAutoLaunchExtension": false,
      "customExtensionsPath": "build/appx-extensions.xml"
    }
  }
}
